---
import Layout from '../../../layouts/Layout.astro';
import { curriculum } from '../../../data/curriculum';

export function getStaticPaths() {
  return curriculum.tracks.map((track) => ({
    params: { track: track.id }
  }));
}

const coSoTrack = curriculum.tracks.find(t => t.id === 'sinh-ly') || curriculum.tracks[0];
const chuyenKhoaTrack = curriculum.tracks.find(t => t.id === 'gay-me-co-so') || curriculum.tracks[1];

const allLessons = [coSoTrack, chuyenKhoaTrack].filter(Boolean).flatMap(track =>
  track.lessons.map(lesson => ({
    ...lesson,
    trackId: track.id,
    trackTitle: track.shortTitle,
    href: lesson.status === 'ready' ? `/learn/${track.id}/${lesson.slug}` : `/learn#${track.id}`
  }))
);

const searchPayload = JSON.stringify(allLessons.map(l => ({
  title: l.title,
  lessonNumber: l.lessonNumber,
  trackId: l.trackId,
  trackTitle: l.trackTitle,
  status: l.status,
  href: l.href
})));
---

<Layout title="Bài học Cơ sở & Chuyên khoa — AnesPath">
  <div class="max-w-5xl mx-auto w-full pt-2 pb-12 space-y-10">

    <!-- 1. TOP 2 HERO FEATURE CARDS (Đặt tại trang Bài học /learn) -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Card Trái: Mục Cơ sở (Sinh lý học) -->
      <div class="bg-[#181818] border border-[#2E2E2E] rounded-2xl p-5 flex flex-col justify-between shadow-lg hover:border-[#3D3D3D] transition">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-md bg-[#222222] border border-[#333333] grid place-items-center text-xs">🫀</span>
              <span class="w-6 h-6 rounded-md bg-[#222222] border border-[#333333] grid place-items-center text-xs">📈</span>
            </div>
            <span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded bg-[#34D399]/15 text-[#34D399] border border-[#34D399]/30">
              MỤC CƠ SỞ · {coSoTrack?.lessons.length || 17} BÀI
            </span>
          </div>

          <div class="flex items-center gap-3.5 bg-[#121212] border border-[#2A2A2A] rounded-xl p-3.5 mb-5">
            <div class="clay-icon-box w-12 h-12 bg-gradient-to-br from-[#34D399] to-[#059669] grid place-items-center text-2xl flex-none text-white">
              🧬
            </div>
            <div class="bg-[#222222] border border-[#333333] rounded-xl px-3.5 py-2 text-xs text-[#E5E7EB] font-medium shadow-inner">
              "Nắm vững cơ chế sinh lý cơ sở trước khi đặt tay lên bơm tiêm điện."
            </div>
          </div>

          <h2 class="text-lg font-bold text-white tracking-tight">
            Mục Cơ sở: <span class="text-[#34D399]">Sinh lý học</span>
          </h2>
          <p class="text-xs text-[#9E9E9E] mt-1.5 leading-relaxed">
            Hệ thống 17 chuyên đề sinh lý học kinh điển (Tuần hoàn, Hô hấp, Thận, Thần kinh tự chủ...) kèm mô phỏng đồ thị tương tác trực quan.
          </p>
        </div>

        <div class="mt-5">
          <a href="#muc-co-so" class="chess-cta-gold w-full py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 text-xs font-extrabold">
            <span>Xem danh sách bài Cơ sở</span>
            <span>↓</span>
          </a>
        </div>
      </div>

      <!-- Card Phải: Mục Chuyên khoa (Gây mê Hồi sức) -->
      <div class="bg-[#181818] border border-[#2E2E2E] rounded-2xl p-5 flex flex-col justify-between shadow-lg hover:border-[#3D3D3D] transition">
        <div>
          <div class="h-28 rounded-xl bg-[#121212] border border-[#2E2E2E] relative overflow-hidden mb-5 flex items-center justify-center">
            <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(45deg, #4B5563 25%, transparent 25%), linear-gradient(-45deg, #4B5563 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #4B5563 75%), linear-gradient(-45deg, transparent 75%, #4B5563 75%); background-size: 32px 32px; background-position: 0 0, 0 16px, 16px -16px, -16px 0;"></div>
            
            <div class="relative z-10 flex items-center gap-6">
              <div class="w-10 h-10 rounded-xl bg-[#222222]/90 border border-[#3D3D3D] grid place-items-center text-lg shadow-md">💉</div>
              <div class="w-12 h-12 rounded-xl bg-[#F5B82E]/20 border border-[#F5B82E] grid place-items-center text-xl shadow-lg">🩺</div>
              <div class="w-10 h-10 rounded-xl bg-[#222222]/90 border border-[#3D3D3D] grid place-items-center text-lg shadow-md">🫁</div>
            </div>

            <span class="absolute top-2.5 right-2.5 bg-[#F5B82E] text-[#121212] text-[10px] font-extrabold px-2.5 py-0.5 rounded-md shadow">
              MỤC CHUYÊN KHOA · {chuyenKhoaTrack?.lessons.length || 8} BÀI
            </span>
          </div>

          <h2 class="text-lg font-bold text-white tracking-tight">
            Mục Chuyên khoa: <span class="text-[#F5B82E]">Gây mê Hồi sức</span>
          </h2>
          <p class="text-xs text-[#9E9E9E] mt-1.5 leading-relaxed">
            Chuyên đề thực hành vô cảm, dược lý thuốc mê – thuốc tê, khám tiền mê và xử trí tai biến biến chứng phòng mổ.
          </p>
        </div>

        <div class="mt-5">
          <a href="#muc-chuyen-khoa" class="w-full py-2.5 px-4 rounded-xl bg-[#1E1E1E] hover:bg-[#262626] border border-[#F5B82E]/70 text-[#F5B82E] flex items-center justify-center gap-2 text-xs font-extrabold transition">
            <span>Xem danh sách bài Chuyên khoa</span>
            <span>↓</span>
          </a>
        </div>
      </div>

    </section>

    <!-- 2. TODAY'S PLAN (Kế hoạch học tập hôm nay) -->
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white">Bài học đang mở khóa (Sẵn sàng học ngay)</h3>
        <span class="text-[11px] text-[#9E9E9E]">Bấm vào thẻ để mở buồng lái tương tác</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="/learn/sinh-ly/chuc-nang-bom-mau-tim" class="chess-btn rounded-xl p-3.5 flex items-center justify-between gap-3 group">
          <div class="flex items-center gap-3 min-w-0">
            <div class="clay-icon-box w-9 h-9 bg-gradient-to-br from-[#38BDF8] to-[#0284C7] grid place-items-center text-sm text-white flex-none">
              04
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-white group-hover:text-[#F5B82E] transition truncate">Vòng Áp lực – Thể tích Thất trái (PV Loop)</div>
              <div class="text-[10px] text-[#9E9E9E] mt-0.5">Mục Cơ sở • Đồ thị tương tác & Sandbox</div>
            </div>
          </div>
          <span class="text-xs font-bold text-[#F5B82E] flex-none">Học ➔</span>
        </a>

        <a href="/learn/sinh-ly/co-hoc-ho-hap" class="chess-btn rounded-xl p-3.5 flex items-center justify-between gap-3 group">
          <div class="flex items-center gap-3 min-w-0">
            <div class="clay-icon-box w-9 h-9 bg-gradient-to-br from-[#34D399] to-[#059669] grid place-items-center text-sm text-white flex-none">
              06
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-white group-hover:text-[#F5B82E] transition truncate">Cơ học hô hấp: Áp suất màng phổi</div>
              <div class="text-[10px] text-[#9E9E9E] mt-0.5">Mục Cơ sở • Video & Phân tích cơ chế</div>
            </div>
          </div>
          <span class="text-xs font-bold text-[#F5B82E] flex-none">Học ➔</span>
        </a>
      </div>
    </section>

    <!-- 3. INTERACTIVE SELECTOR BOX (Chọn 1 trong 2 phân khu & Tìm bài) -->
    <section class="bg-[#181818] border border-[#2E2E2E] rounded-2xl p-5 sm:p-6 shadow-xl space-y-5">
      
      <!-- 2 Big Tab Cards: Cơ sở vs Chuyên khoa -->
      <div class="grid grid-cols-2 gap-3" id="quickModeTabs">
        <button data-mode="sinh-ly" class="mode-tab chess-btn chess-btn-active rounded-xl p-4 flex flex-col items-center justify-center gap-2 cursor-pointer">
          <div class="clay-icon-box w-9 h-9 bg-gradient-to-br from-[#34D399] to-[#059669] grid place-items-center text-base text-white">
            🫀
          </div>
          <span class="text-xs sm:text-sm font-bold text-white">Mục Cơ sở · Sinh lý</span>
        </button>

        <button data-mode="gay-me-co-so" class="mode-tab chess-btn rounded-xl p-4 flex flex-col items-center justify-center gap-2 cursor-pointer">
          <div class="clay-icon-box w-9 h-9 bg-gradient-to-br from-[#A855F7] to-[#7E22CE] grid place-items-center text-base text-white">
            💉
          </div>
          <span class="text-xs sm:text-sm font-bold text-white">Mục Chuyên khoa · GMHS</span>
        </button>
      </div>

      <!-- Input Search -->
      <div class="space-y-2">
        <label id="quickInputLabel" for="quickTopicInput" class="block text-xs font-semibold text-[#D1D5DB]">
          Tìm nhanh bài học trong Mục Cơ sở — Sinh lý học ({coSoTrack?.lessons.length || 17} bài)
        </label>
        <div class="relative">
          <input
            id="quickTopicInput"
            type="text"
            placeholder="Nhập tên bài: Vòng PV thất trái, Cơ học hô hấp, Thần kinh tự chủ..."
            class="w-full bg-[#121212] border border-[#2E2E2E] focus:border-[#F5B82E] rounded-xl px-4 py-3 text-sm text-white placeholder-[#6B7280] focus:outline-none transition"
          />
          <div id="quickSearchResults" class="hidden absolute left-0 right-0 top-[calc(100%+6px)] bg-[#1E1E1E] border border-[#3D3D3D] rounded-xl shadow-2xl z-30 max-h-60 overflow-y-auto custom-scrollbar"></div>
        </div>
      </div>

      <button id="btnQuickGo" class="chess-cta-gold w-full py-3.5 px-6 rounded-xl flex items-center justify-center gap-2.5 text-sm font-extrabold cursor-pointer">
        <span>🔍</span>
        <span id="btnQuickGoText">Chuyển tới Mục Cơ sở (Sinh lý)</span>
      </button>
    </section>

    <!-- 4. DANH SÁCH BÀI HỌC CHI TIẾT CỦA 2 MỤC -->
    
    <!-- MỤC CƠ SỞ: SINH LÝ -->
    {coSoTrack && (
      <section id="muc-co-so" class="space-y-4 pt-2 scroll-mt-6">
        <div class="flex items-center justify-between bg-[#181818] border border-[#2E2E2E] rounded-2xl p-4">
          <div class="flex items-center gap-3">
            <div class="clay-icon-box w-9 h-9 bg-gradient-to-br from-[#34D399] to-[#059669] grid place-items-center text-base text-white">🫀</div>
            <div>
              <div class="text-[10px] font-extrabold text-[#34D399] uppercase tracking-wider">PHẦN 01 · MỤC CƠ SỞ</div>
              <h2 class="text-lg font-bold text-white">{coSoTrack.title}</h2>
            </div>
          </div>
          <span class="font-mono text-xs text-[#9E9E9E]">{coSoTrack.lessons.length} bài</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {coSoTrack.lessons.map((lesson) => {
            const isReady = lesson.status === 'ready';
            const card = (
              <div class:list={[
                "rounded-xl p-4 border flex items-start justify-between gap-3 transition",
                isReady ? "chess-btn border-[#333333] hover:border-[#F5B82E]" : "bg-[#181818]/60 border-[#262626] opacity-65"
              ]}>
                <div class="min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-mono text-[11px] font-bold text-[#34D399]">{lesson.lessonNumber}</span>
                    {lesson.group && <span class="text-[10px] text-[#737373]">• {lesson.group}</span>}
                  </div>
                  <h3 class="text-sm font-bold text-white leading-snug">{lesson.title}</h3>
                  <p class="text-xs text-[#9E9E9E] line-clamp-2 mt-1">{lesson.summary}</p>
                </div>
                {isReady ? (
                  <span class="flex-none text-[9px] font-extrabold px-2 py-0.5 rounded bg-[#22C55E]/15 text-[#22C55E] border border-[#22C55E]/40">SẴN SÀNG</span>
                ) : (
                  <span class="flex-none text-[9px] font-bold px-2 py-0.5 rounded bg-[#121212] text-[#737373] border border-[#2E2E2E]">SOẠN THẢO</span>
                )}
              </div>
            );
            return isReady ? <a href={`/learn/${coSoTrack.id}/${lesson.slug}`} class="block">{card}</a> : <div>{card}</div>;
          })}
        </div>
      </section>
    )}

    <!-- MỤC CHUYÊN KHOA: GÂY MÊ HỒI SỨC -->
    {chuyenKhoaTrack && (
      <section id="muc-chuyen-khoa" class="space-y-4 pt-4 scroll-mt-6">
        <div class="flex items-center justify-between bg-[#181818] border border-[#2E2E2E] rounded-2xl p-4">
          <div class="flex items-center gap-3">
            <div class="clay-icon-box w-9 h-9 bg-gradient-to-br from-[#A855F7] to-[#7E22CE] grid place-items-center text-base text-white">💉</div>
            <div>
              <div class="text-[10px] font-extrabold text-[#C084FC] uppercase tracking-wider">PHẦN 02 · MỤC CHUYÊN KHOA</div>
              <h2 class="text-lg font-bold text-white">{chuyenKhoaTrack.title}</h2>
            </div>
          </div>
          <span class="font-mono text-xs text-[#9E9E9E]">{chuyenKhoaTrack.lessons.length} bài</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {chuyenKhoaTrack.lessons.map((lesson) => {
            const isReady = lesson.status === 'ready';
            const card = (
              <div class:list={[
                "rounded-xl p-4 border flex items-start justify-between gap-3 transition",
                isReady ? "chess-btn border-[#333333] hover:border-[#F5B82E]" : "bg-[#181818]/60 border-[#262626] opacity-65"
              ]}>
                <div class="min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-mono text-[11px] font-bold text-[#C084FC]">{lesson.lessonNumber}</span>
                    {lesson.group && <span class="text-[10px] text-[#737373]">• {lesson.group}</span>}
                  </div>
                  <h3 class="text-sm font-bold text-white leading-snug">{lesson.title}</h3>
                  <p class="text-xs text-[#9E9E9E] line-clamp-2 mt-1">{lesson.summary}</p>
                </div>
                {isReady ? (
                  <span class="flex-none text-[9px] font-extrabold px-2 py-0.5 rounded bg-[#22C55E]/15 text-[#22C55E] border border-[#22C55E]/40">SẴN SÀNG</span>
                ) : (
                  <span class="flex-none text-[9px] font-bold px-2 py-0.5 rounded bg-[#121212] text-[#737373] border border-[#2E2E2E]">SOẠN THẢO</span>
                )}
              </div>
            );
            return isReady ? <a href={`/learn/${chuyenKhoaTrack.id}/${lesson.slug}`} class="block">{card}</a> : <div>{card}</div>;
          })}
        </div>
      </section>
    )}

  </div>

  <script type="application/json" id="learnSearchPayload" set:html={searchPayload}></script>
  <script is:inline>
    (function() {
      const payloadEl = document.getElementById('learnSearchPayload');
      const lessons = payloadEl ? JSON.parse(payloadEl.textContent || '[]') : [];

      let activeMode = 'sinh-ly';
      const tabs = document.querySelectorAll('.mode-tab');
      const labelEl = document.getElementById('quickInputLabel');
      const inputEl = document.getElementById('quickTopicInput');
      const resultsEl = document.getElementById('quickSearchResults');
      const goBtn = document.getElementById('btnQuickGo');
      const goBtnText = document.getElementById('btnQuickGoText');

      const modeMeta = {
        'sinh-ly': {
          label: 'Tìm nhanh bài học trong Mục Cơ sở — Sinh lý học (17 bài)',
          placeholder: 'Nhập tên bài: Vòng PV thất trái, Cơ học hô hấp, Thần kinh tự chủ...',
          btnText: 'Chuyển tới Mục Cơ sở (Sinh lý)',
          anchor: '#muc-co-so'
        },
        'gay-me-co-so': {
          label: 'Tìm nhanh bài học trong Mục Chuyên khoa — Gây mê Hồi sức (08 bài)',
          placeholder: 'Nhập tên bài: Khám tiền mê, Thuốc trong GMHS, Tai biến biến chứng...',
          btnText: 'Chuyển tới Mục Chuyên khoa (GMHS)',
          anchor: '#muc-chuyen-khoa'
        }
      };

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          tabs.forEach(function(t) { t.classList.remove('chess-btn-active'); });
          tab.classList.add('chess-btn-active');
          activeMode = tab.getAttribute('data-mode') || 'sinh-ly';
          const meta = modeMeta[activeMode];
          if (meta) {
            if (labelEl) labelEl.textContent = meta.label;
            if (inputEl) inputEl.placeholder = meta.placeholder;
            if (goBtnText) goBtnText.textContent = meta.btnText;
          }
          renderResults();
        });
      });

      function renderResults() {
        if (!inputEl || !resultsEl) return;
        const q = inputEl.value.toLowerCase().trim();
        if (!q) {
          resultsEl.classList.add('hidden');
          return;
        }
        const filtered = lessons.filter(function(item) {
          return item.trackId === activeMode &&
            (item.title.toLowerCase().includes(q) || item.lessonNumber.toLowerCase().includes(q));
        });

        if (filtered.length === 0) {
          resultsEl.innerHTML = '<div class="p-3 text-xs text-[#9E9E9E]">Không tìm thấy bài học khớp từ khóa trong mục này.</div>';
        } else {
          resultsEl.innerHTML = filtered.map(function(item) {
            const badge = item.status === 'ready'
              ? '<span class="text-[9px] font-bold px-2 py-0.5 rounded bg-[#22C55E]/15 text-[#22C55E] border border-[#22C55E]/40">SẴN SÀNG</span>'
              : '<span class="text-[9px] font-bold px-2 py-0.5 rounded bg-[#262626] text-[#9E9E9E]">SOẠN THẢO</span>';
            return '<a href="' + item.href + '" class="flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-[#282828] border-b border-[#2E2E2E] last:border-b-0 transition">' +
              '<div><span class="font-mono text-[10px] text-[#F5B82E] font-bold mr-2">' + item.lessonNumber + '</span>' +
              '<span class="text-xs font-bold text-white">' + item.title + '</span></div>' +
              badge + '</a>';
          }).join('');
        }
        resultsEl.classList.remove('hidden');
      }

      if (inputEl) {
        inputEl.addEventListener('input', renderResults);
        inputEl.addEventListener('focus', renderResults);
      }

      document.addEventListener('click', function(e) {
        if (resultsEl && inputEl && !resultsEl.contains(e.target) && e.target !== inputEl) {
          resultsEl.classList.add('hidden');
        }
      });

      if (goBtn) {
        goBtn.addEventListener('click', function() {
          const q = (inputEl && inputEl.value || '').toLowerCase().trim();
          if (q) {
            const firstMatch = lessons.find(function(item) {
              return item.trackId === activeMode && item.title.toLowerCase().includes(q);
            });
            if (firstMatch) {
              window.location.href = firstMatch.href;
              return;
            }
          }
          const meta = modeMeta[activeMode];
          if (meta && meta.anchor) {
            const target = document.querySelector(meta.anchor);
            if (target) target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }
    })();
  </script>
</Layout>