---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Pete McPherson">
  <div class="max-w-2xl space-y-8">
    <div>
      <span class="text-xs font-mono uppercase tracking-widest text-[#FF0033]">Biography</span>
      <h1 class="text-5xl md:text-7xl font-bold uppercase mt-2">About</h1>
    </div>

    <div class="space-y-6 text-neutral-800 leading-relaxed text-base md:text-lg">
      <p>
        Building digital tools at the intersection of medical logic and minimalist software engineering.
      </p>
      <p class="text-neutral-600 text-base">
        Background focused on systematic workflows, clinical precision, and clean editorial interfaces without unnecessary fluff.
      </p>
    </div>

    <div class="pt-8 border-t border-black/10 flex gap-6 text-xs uppercase tracking-wider font-semibold">
      <a href="https://github.com" target="_blank" class="hover:text-[#FF0033] transition-colors">GitHub &nearr;</a>
      <a href="mailto:contact@example.com" class="hover:text-[#FF0033] transition-colors">Email &nearr;</a>
    </div>
  </div>
</Layout>