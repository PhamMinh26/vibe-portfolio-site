---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Clinical Tools — AnesPath" description="Bộ công cụ tính toán và bảng tra lâm sàng tức thì.">
  <div class="py-6 border-b border-[#E4EAF0] mb-10">
    <span class="text-[11px] font-semibold text-[#687789] uppercase tracking-wider block mb-2">Bedside Utilities</span>
    <h1 class="text-4xl font-bold text-[#101F35] tracking-tight mb-3">Clinical Tools</h1>
    <p class="text-sm sm:text-base text-[#687789] max-w-2xl leading-relaxed">
      Các công cụ tính toán nhanh tại giường bệnh: oxy hóa máu, thăng bằng kiềm toan Stewart, liều thuốc mê truyền tĩnh mạch đích (TCI) và các thang điểm tiên lượng.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-[#FFFFFF] border border-[#E4EAF0] p-6 rounded">
      <h2 class="text-base font-bold text-[#101F35] mb-1">Hemodynamics</h2>
      <p class="text-xs text-[#687789] mb-4">Tính cung lượng tim, SVR, PVR, DO2/VO2.</p>
      <span class="text-[10px] text-[#687789] uppercase tracking-wider">Sắp ra mắt</span>
    </div>
    <div class="bg-[#FFFFFF] border border-[#E4EAF0] p-6 rounded">
      <h2 class="text-base font-bold text-[#101F35] mb-1">Mechanical Ventilation</h2>
      <p class="text-xs text-[#687789] mb-4">Driving pressure, độ giãn nở phổi (compliance), oxy hóa máu (PaO2/FiO2).</p>
      <span class="text-[10px] text-[#687789] uppercase tracking-wider">Sắp ra mắt</span>
    </div>
    <div class="bg-[#FFFFFF] border border-[#E4EAF0] p-6 rounded">
      <h2 class="text-base font-bold text-[#101F35] mb-1">Acid-Base Balance</h2>
      <p class="text-xs text-[#687789] mb-4">Phân tích khí máu động mạch theo phương pháp truyền thống & Stewart (SID, SIG).</p>
      <span class="text-[10px] text-[#687789] uppercase tracking-wider">Sắp ra mắt</span>
    </div>
  </div>
</Layout>