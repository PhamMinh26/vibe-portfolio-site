    <!-- 4. EDITORIAL EXPLANATION SECTIONS (Giống phần chữ phía dưới của Chessigma) -->
    <section class="max-w-3xl mx-auto space-y-8 pt-4 text-[#D1D5DB]">
      <div class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold text-white">
