---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: "Emergency Order Trainer",
    category: "Web Application / Medical",
    year: "2026",
    desc: "A mobile-first simulation tool helping resident doctors practice standard clinical order writing.",
    link: "#"
  },
  {
    title: "Triage Standardizer",
    category: "Clinical Workflow",
    year: "2026",
    desc: "Fast clinical physical examination terminology mapping for triage nurses.",
    link: "#"
  },
  {
    title: "Minimal Editorial Portfolio",
    category: "Design & Architecture",
    year: "2026",
    desc: "Personal archive focusing on extreme typography, whitespace, and Astro v7 performance.",
    link: "#"
  }
];
---

<Layout title="Pete McPherson — Minimal Portfolio">
  <!-- Hero Section -->
  <section class="space-y-6 pt-4 pb-16 border-b border-black/10">
    <div class="inline-block text-xs uppercase tracking-widest font-semibold px-2 py-1 bg-[#FF0033] text-white">
      Available for Select Work
    </div>

    <h1 class="text-6xl md:text-8xl uppercase leading-[0.9] tracking-tight font-bold">
      Design with intent. <br />
      Code with <span class="text-[#FF0033]">precision.</span>
    </h1>

    <p class="text-lg md:text-xl text-neutral-600 leading-relaxed max-w-2xl pt-2">
      I build high-whitespace digital systems, minimal products, and practical software with focus on clarity and speed.
    </p>
  </section>

  <!-- Selected Projects Grid/List -->
  <section class="py-16">
    <div class="flex justify-between items-baseline mb-12">
      <h2 class="text-3xl font-bold uppercase tracking-tight">Selected Projects</h2>
      <a href="/projects" class="text-xs uppercase tracking-wider font-semibold hover:text-[#FF0033] transition-colors">
        View All [03] &rarr;
      </a>
    </div>

    <div class="divide-y divide-black/10">
      {projects.map((item) => (
        <a 
          href={item.link} 
          class="group py-8 flex flex-col md:flex-row md:items-baseline justify-between transition-all hover:pl-2"
        >
          <div class="md:w-1/3">
            <h3 class="text-2xl font-bold uppercase group-hover:text-[#FF0033] transition-colors">
              {item.title}
            </h3>
            <span class="text-xs text-neutral-400 uppercase tracking-widest mt-1 block">
              {item.category} — {item.year}
            </span>
          </div>
          <p class="mt-2 md:mt-0 md:w-1/2 text-neutral-600 text-sm leading-relaxed">
            {item.desc}
          </p>
          <div class="hidden md:block text-right md:w-1/6 font-mono text-xs opacity-0 group-hover:opacity-100 group-hover:text-[#FF0033] transition-opacity">
            EXPLORE &nearr;
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>