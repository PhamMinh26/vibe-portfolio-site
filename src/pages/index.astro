---
import Layout from '../layouts/Layout.astro';
import { curriculum } from '../data/curriculum';

const allLessons = curriculum.tracks.flatMap(track =>
  track.lessons.map(lesson => ({
    ...lesson,
    trackId: track.id,
    trackTitle: track.shortTitle,
    href: lesson.status === 'ready' ? `/learn/${track.id}/${lesson.slug}` : `/learn`
  }))
);

const searchPayload = JSON.stringify(allLessons.map(l => ({
  title: l.title,
  lessonNumber: l.lessonNumber,
  trackId: l.trackId,
  trackTitle: l.trackTitle,
  status: l.status,
  href: l.href
})));
---

<Layout title="ANESPATH — Nền tảng Học tập Gây mê Hồi sức & Sinh lý học Chiến thuật">
  <div class="max-w-5xl mx-auto w-full pt-2 pb-12 space-y-10">

    <!-- 1. TOP 2 HERO FEATURE CARDS (Chuẩn bố cục Chessigma) -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Card Trái: Mô phỏng Tương tác -->
      <div class="bg-[#181818] border border-[#2E2E2E] rounded-2xl p-5 flex flex-col justify-between shadow-lg hover:border-[#3D3D3D] transition">
        <div>
          <!-- Top Mini Badges & Mascot Speech Bubble -->
          <div class="flex items-center gap-2 mb-4">
            <span class="w-6 h-6 rounded-md bg-[#222222] border border-[#333333] grid place-items-center text-xs">🫀</span>
            <span class="w-6 h-6 rounded-md bg-[#222222] border border-[#333333] grid place-items-center text-xs">📈</span>
          </div>

          <div class="flex items-center gap-3.5 bg-[#121212] border border-[#2A2A2A] rounded-xl p-3.5 mb-5">
            <div class="clay-icon-box w-12 h-12 bg-gradient-to-br from-[#FBBF24] to-[#D97706] grid place-items-center text-2xl flex-none text-[#121212]">
              🩺
            </div>
            <div class="bg-[#222222] border border-[#333333] rounded-xl px-3.5 py-2 text-xs text-[#E5E7EB] font-medium shadow-inner">
              "Nắm vững cơ chế sinh lý trước khi đặt tay lên bơm tiêm điện."
            </div>
          </div>

          <h2 class="text-lg font-bold text-white tracking-tight">
            Phòng thí nghiệm <span class="text-[#F5B82E]">Sinh lý tương tác</span>
          </h2>
          <p class="text-xs text-[#9E9E9E] mt-1.5 leading-relaxed">
            Trực quan hóa vòng Áp lực – Thể tích thất trái (PV Loop), thay đổi tiền tải, hậu tải và sức co bóp theo thời gian thực ngay trên trình duyệt.
          </p>
        </div>

        <div class="mt-5">
          <a href="/learn/sinh-ly/chuc-nang-bom-mau-tim" class="chess-cta-gold w-full py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 text-xs font-extrabold">
            <span>Trải nghiệm mô phỏng ngay</span>
            <span>➔</span>
          </a>
        </div>
      </div>

      <!-- Card Phải: Kho Bài Giảng Repertoire (Có nền bàn cờ) -->
      <div class="bg-[#181818] border border-[#2E2E2E] rounded-2xl p-5 flex flex-col justify-between shadow-lg hover:border-[#3D3D3D] transition">
        <div>
          <!-- Banner Bàn cờ & Đồ thị -->
          <div class="h-28 rounded-xl bg-[#121212] border border-[#2E2E2E] relative overflow-hidden mb-5 flex items-center justify-center">
            <!-- Họa tiết ô bàn cờ -->
            <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(45deg, #4B5563 25%, transparent 25%), linear-gradient(-45deg, #4B5563 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #4B5563 75%), linear-gradient(-45deg, transparent 75%, #4B5563 75%); background-size: 32px 32px; background-position: 0 0, 0 16px, 16px -16px, -16px 0;"></div>
            
            <!-- Các quân cờ / biểu tượng y khoa trên bàn -->
            <div class="relative z-10 flex items-center gap-6">
              <div class="w-10 h-10 rounded-xl bg-[#222222]/90 border border-[#3D3D3D] grid place-items-center text-lg shadow-md">♟️</div>
              <div class="w-12 h-12 rounded-xl bg-[#F5B82E]/20 border border-[#F5B82E] grid place-items-center text-xl shadow-lg">♞</div>
              <div class="w-10 h-10 rounded-xl bg-[#222222]/90 border border-[#3D3D3D] grid place-items-center text-lg shadow-md">♝</div>
            </div>

            <!-- Badge vàng góc phải -->
            <span class="absolute top-2.5 right-2.5 bg-[#F5B82E] text-[#121212] text-[10px] font-extrabold px-2.5 py-0.5 rounded-md shadow">
              25 chuyên đề cốt lõi
            </span>
          </div>

          <h2 class="text-lg font-bold text-white tracking-tight">
            Hệ thống bài học Gây mê & Sinh lý
          </h2>
          <p class="text-xs text-[#9E9E9E] mt-1.5 leading-relaxed">
            Chia nhỏ từng bài thành các biến thể cơ chế, bẫy lâm sàng (Trap) và câu hỏi lượng giá từng bước theo phong cách Chess Opening Trainer.
          </p>
        </div>

        <div class="mt-5">
          <a href="/learn" class="w-full py-2.5 px-4 rounded-xl bg-[#1E1E1E] hover:bg-[#262626] border border-[#F5B82E]/70 text-[#F5B82E] flex items-center justify-center gap-2 text-xs font-extrabold transition">
